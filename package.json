{
  "name": "mockable",
  "version": "1.0.0",
  "description": "Generate type-safe Jest mocks for TypeScript classes and interfaces.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc && node esbuild.config.js",
    "build-dry-run": "tsc && node esbuild.config.js && npm pack --dry-run",
    "watch-mode": "tsc -w -p tsconfig.json",
    "start-dev": "node ./src/examples/dry-run.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "prettify": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint . --ext .ts --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rohit1901/mockable.git"
  },
  "keywords": [
    "typescript",
    "mocking",
    "jest",
    "testing",
    "unit-testing"
  ],
  "author": "Rohit Khanduri",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rohit1901/mockable/issues"
  },
  "homepage": "https://github.com/rohit1901/mockable#readme",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "auto-changelog": "^1.16.4",
    "esbuild": "^0.25.0",
    "esbuild-node-externals": "^1.13.1",
    "eslint": "^8.57.1",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-unused-imports": "^3.2.0",
    "gh-release": "^3.5.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testRegex": "(src/__tests__/.*|(\\.|/)(test|spec))\\.(jsx?|tsx?)$",
    "testPathIgnorePatterns": [
      "helpers.ts"
    ],
    "maxWorkers": 1,
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  }
}
